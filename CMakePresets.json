{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "win32-msvc",
      "displayName": "Windows x86 MSVC (upstream reference, D3D9)",
      "description": "Builds into build/ so setup.ps1 and Play.bat find build/Release as before.",
      "binaryDir": "${sourceDir}/build",
      "architecture": { "value": "Win32", "strategy": "set" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "win32-msvc-offline",
      "displayName": "Windows x86 MSVC with BO1_OFFLINE (phase 1c: stubs played against the reference)",
      "inherits": "win32-msvc",
      "binaryDir": "${sourceDir}/build/win32-offline",
      "cacheVariables": { "BO1_OFFLINE": "ON" }
    },
    {
      "name": "win64-clangcl",
      "displayName": "Windows x64 clang-cl (phase 3: 64-bit cleanup, still D3D9)",
      "binaryDir": "${sourceDir}/build/win64-clangcl",
      "architecture": { "value": "x64", "strategy": "set" },
      "toolset": { "value": "ClangCL", "strategy": "set" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "mingw32-gcc",
      "displayName": "MinGW i686 GCC (phase 1 syntax pass, GNU dialect)",
      "description": "Only for tools/syntax_check.py. Pass -DDXSDK_DIR=<June 2010 SDK root> for the headers MinGW lacks.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/mingw32-gcc",
      "toolchainFile": "${sourceDir}/tools/toolchains/mingw-i686-gcc.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "CMAKE_EXPORT_COMPILE_COMMANDS": "ON" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "mingw32-clang",
      "displayName": "MinGW i686 clang (phase 1 syntax pass, GNU dialect)",
      "description": "Only for tools/syntax_check.py. Pass -DDXSDK_DIR=<June 2010 SDK root> for the headers MinGW lacks.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/mingw32-clang",
      "toolchainFile": "${sourceDir}/tools/toolchains/mingw-i686-clang.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "CMAKE_EXPORT_COMPILE_COMMANDS": "ON" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "linux64-clang",
      "displayName": "Linux x86_64 clang (phase 4: portable layer + GL backend)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux64-clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "switch",
      "displayName": "Nintendo Switch (devkitA64 + libnx, phase 5)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/switch",
      "toolchainFile": "$env{DEVKITPRO}/cmake/Switch.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    }
  ],
  "buildPresets": [
    { "name": "win32-msvc-release", "configurePreset": "win32-msvc", "configuration": "Release" },
    { "name": "win32-msvc-debug", "configurePreset": "win32-msvc", "configuration": "Debug" },
    { "name": "win32-msvc-offline-release", "configurePreset": "win32-msvc-offline", "configuration": "Release" },
    { "name": "win64-clangcl-release", "configurePreset": "win64-clangcl", "configuration": "Release" },
    { "name": "linux64-clang", "configurePreset": "linux64-clang" },
    { "name": "switch", "configurePreset": "switch" }
  ]
}
